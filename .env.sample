# Telegram (Pyrogram — needs api_id and api_hash from https://my.telegram.org)
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_API=12345678
TELEGRAM_HASH=your_api_hash

# Google Drive (optional — for /drive and mirror-to-drive)
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
GCP_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# Admin
ADMIN_ID=your_telegram_user_id
